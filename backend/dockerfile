# apps/api/Dockerfile
FROM node:20-alpine

# Define diretório de trabalho
WORKDIR /app

# Copia dependências e instala apenas as necessárias em produção
COPY package*.json ./
RUN npm ci --only=production

# Copia o restante do código da API
COPY . .

# Define variáveis padrão
ENV NODE_ENV=production
ENV PORT=3000

# Cria diretório de uploads (usando a variável de ambiente)
# Se não estiver definida no build, cria /app/uploads por padrão
ARG UPLOAD_PATH=/app/uploads
ENV UPLOAD_PATH=${UPLOAD_PATH}
RUN mkdir -p ${UPLOAD_PATH} && chmod -R 777 ${UPLOAD_PATH}

# Usa o usuário padrão 'node' (mais seguro)
USER node

# Expõe a porta da aplicação
EXPOSE 3000

# Se usar Prisma, descomente a linha abaixo:
# RUN npx prisma generate

# Comando de inicialização
CMD ["node", "server.js"]
