# apps/api/Dockerfile
FROM node:20-alpine

WORKDIR /app

# 1) Copia manifestos e instala TODAS dependências (inclui dev)
COPY package*.json ./
RUN npm ci

# 2) Copia o restante do código + a pasta prisma
#    (garanta que a pasta 'prisma' está no repo e NÃO está no .dockerignore)
COPY . .
# Se seu monorepo tiver 'prisma' fora de apps/api, ajuste o caminho:
# COPY prisma ./prisma

# 3) Variáveis básicas
ENV NODE_ENV=production
ENV PORT=3000

# 4) Gera o client do Prisma (não precisa de conexão com DB)
RUN npx prisma generate

# 5) Remove devDependencies para imagem final enxuta
RUN npm prune --production

# (opcional) cria diretório de uploads via env, se você usa UPLOAD_PATH
ARG UPLOAD_PATH=/app/uploads
ENV UPLOAD_PATH=${UPLOAD_PATH}
RUN mkdir -p ${UPLOAD_PATH} && chmod -R 755 ${UPLOAD_PATH}

EXPOSE 3000

# Se quiser aplicar migrações na subida (alternativa ao Post-deploy):
# CMD [ "sh", "-c", "npx prisma migrate deploy && node server.js" ]
CMD ["node", "server.js"]